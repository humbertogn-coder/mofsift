{
  "$id": "https://github.com/humbertogn-coder/mofsift/schemas/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "columns": {
      "items": {
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "boolean",
              "integer",
              "number",
              "string"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "type",
          "group",
          "unit",
          "description"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "config": {
      "description": "The validated config of the run; null for a merged bundle.",
      "type": [
        "object",
        "null"
      ]
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "counts": {
      "properties": {
        "enumerated": {
          "description": "Rows before the filters.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "selected": {
          "description": "Rows in this bundle.",
          "minimum": 0,
          "type": "integer"
        },
        "structures": {
          "description": "Records with a structure file.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enumerated",
        "selected",
        "structures"
      ],
      "type": "object"
    },
    "created_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "files": {
      "additionalProperties": {
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "description": "Every file of the bundle except the manifest, by relative path.",
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_.\\-/]+$"
      },
      "type": "object"
    },
    "filters": {
      "items": {
        "properties": {
          "expression": {
            "type": "string"
          },
          "passed": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "rejected": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "undecided": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "expression",
          "passed",
          "rejected",
          "undecided"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "mofsift-bundle"
    },
    "mofsift_version": {
      "type": "string"
    },
    "notices": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "project": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "records": {
      "properties": {
        "n_records": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "const": "candidates.json"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "n_records",
        "sha256"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "schema_version": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "sources": {
      "description": "The bundles a merged bundle was made from; empty otherwise.",
      "items": {
        "properties": {
          "config_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_utc": {
            "type": "string"
          },
          "manifest_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "mofsift_version": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "selected": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "project",
          "config_hash",
          "mofsift_version",
          "created_utc",
          "selected",
          "manifest_sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stages": {
      "items": {
        "properties": {
          "stage": {
            "type": "string"
          }
        },
        "required": [
          "stage"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "structures": {
      "properties": {
        "directory": {
          "const": "structures"
        },
        "format": {
          "const": "cif"
        },
        "n_files": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "directory",
        "format",
        "n_files"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "table": {
      "properties": {
        "format": {
          "enum": [
            "csv",
            "parquet"
          ]
        },
        "n_columns": {
          "minimum": 0,
          "type": "integer"
        },
        "n_rows": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "enum": [
            "candidates.csv",
            "candidates.parquet"
          ]
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "format",
        "n_rows",
        "n_columns",
        "sha256"
      ],
      "type": "object"
    },
    "third_party": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "tools": {
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "mofsift_version",
    "project",
    "created_utc",
    "config_hash",
    "config",
    "counts",
    "filters",
    "stages",
    "tools",
    "columns",
    "table",
    "records",
    "structures",
    "files",
    "sources",
    "notices",
    "third_party",
    "warnings"
  ],
  "title": "mofsift bundle manifest",
  "type": "object"
}
